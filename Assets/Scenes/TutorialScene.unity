  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 73374181}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 523210f95f7b5d6489b29d9ba01c021f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LaboratorietUI
  tools:
  - toolName: "R\xF8ntgen"
    description: "R\xF8ntgen er konservatorens f\xF8rste blik ind i en urenset genstand.
      Str\xE5lingen passerer gennem korrosion og aflejringer og tegner konturerne
      af det oprindelige objekt. Det kan v\xE6re et sv\xE6rd, en kniv eller et beslag.
      Billedet fort\xE6ller dig, hvad du har med at g\xF8re, og hvor du kan rense
      sikkert."
    icon: {fileID: 21300000, guid: 52c9501b6a552e44fa626bace8e1dacd, type: 3}
  - toolName: Mejsel
    description: "Mejslen er konservatorens pr\xE6cisionsv\xE6rkt\xF8j til at fjerne
      kompakt jord og korrosion. Det vibrerende blad l\xF8sner aflejringer lag for
      lag uden at beskadige overfladen nedenunder. Den bruges, hvor penslen ikke
      er nok, men hvor der stadig kr\xE6ves kontrol og forsigtighed."
    icon: {fileID: 21300000, guid: 4644255165dc9f1439f462e82e2c8961, type: 3}
  - toolName: "B\xF8rste"
    description: "Med bl\xF8de b\xF8rsteh\xE5r fjernes l\xF8st st\xF8v, sand og overfladisk
      snavs fra genstanden. Den kr\xE6ver t\xE5lmodighed og et let h\xE5nd, for selv
      det der ser uskyldigt ud kan d\xE6kke over skr\xF8belige detaljer."
    icon: {fileID: 21300000, guid: 4fe40b1fcdb3161479cae6503fb6bd7b, type: 3}
  - toolName: Desalination
    description: "Selv efter udgravning forts\xE6tter saltet i metallet med at nedbryde
      genstanden indefra. Desalinering tr\xE6kker disse skadelige klorider ud ved
      at lade genstanden ligge i vand over tid."
    icon: {fileID: 21300000, guid: 8d48f2074dd1d4140b890542fbb2735a, type: 3}
  - toolName: Lak
    description: "N\xE5r genstanden er renset og stabiliseret, skal overfladen beskyttes
      mod fremtidig nedbrydning. En tynd coating af voks eller lak lukker af for
      ilt og fugt, som ellers ville s\xE6tte korrosionen i gang igen. Behandlingen
      v\xE6lges med omhu, s\xE5 den kan fjernes igen hvis fremtidige konservatorer
      f\xE5r brug for at arbejde videre med genstanden."
    icon: {fileID: 21300000, guid: dacb1d04e00811f4bade1d8a1cabd8d2, type: 3}
